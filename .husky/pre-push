#!/bin/sh

# CI local: mismos pasos que correria un pipeline de CI real (GitHub
# Actions) si se agrega despues. Corta en el primer fallo. Mismo espiritu
# que el pre-push del repo Portafolio (docs/TODO.md seccion 4 de ese
# repo).
#
# `bun audit` a proposito NO esta aqui como gate: a diferencia de
# lint/typecheck/test (deterministas, cambian solo si cambia el codigo),
# el resultado de audit cambia cuando se publica un CVE nuevo para una
# dependencia sin tocar - gatear cada push con eso rompe pushes que no
# tienen nada que ver con el cambio. Se corre manualmente/periodico y se
# documenta en docs/00-auditoria.md, igual que se hizo en Portafolio
# (docs/TODO.md seccion 1.5 de ese repo).
set -e

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

echo "🔍 CI local antes del push..."

echo "📦 1/3 Biome (lint + format)..."
bunx biome check --write ./src ./tests

echo "🔎 2/3 TypeScript (tsc --noEmit)..."
bunx tsc --noEmit

echo "🧪 3/3 bun test..."
bun test

echo "✅ Todo verde. Subiendo. 🚀"
