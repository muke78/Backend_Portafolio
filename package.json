{
  "name": "backend-portafolio",
  "type": "module",
  "version": "0.3.0",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "backup:turso": "bun run scripts/backup-turso.ts",
    "seed:admin": "bun run scripts/seed-admin-user.ts",
    "format": "bunx biome format --write ./src ./tests ./scripts",
    "lint": "bunx biome lint --write ./src ./tests ./scripts",
    "check": "bunx biome check --write ./src ./tests ./scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@libsql/client": "^0.18.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.7",
    "husky": "9.1.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^20.11.17",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "ws": ">=8.20.1"
  }
}
